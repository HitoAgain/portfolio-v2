rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // แทน ADMIN_UID ด้วย User UID ของบัญชีแอดมิน (Firebase > Authentication > Users)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ADMIN_UID';
    }

    // ทุกคนอ่านผลงานได้ แต่เพิ่ม แก้ไข หรือลบได้เฉพาะแอดมิน
    match /works/{workId} {
      allow read: if true;
      allow write: if isAdmin();

      match /images/{imageId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
  }
}
